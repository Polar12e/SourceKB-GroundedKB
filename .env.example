# GroundedKB local configuration example.
# Copy to .env and fill in your own values. Never commit real credentials.

# LLM gateway (DeepSeek OpenAI-compatible endpoint).
# The answer path remains extractive until LLM_ENABLED=true and a key is set.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY_ENV=DEEPSEEK_API_KEY
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0
LLM_FALLBACK=extractive
DEEPSEEK_API_KEY=

# Service ports
GATEWAY_PORT=8080
RETRIEVAL_PORT=8081
INGEST_PORT=8082
AGENT_PORT=8083
MODEL_GATEWAY_PORT=8084
