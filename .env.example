# GroundedKB local configuration example.
# Copy to .env and fill in your own values. Never commit real credentials.

# LLM provider: auto | openai | deepseek | local | custom
FIN_AGENT_PROVIDER=deepseek
FIN_AGENT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Optional generic key for a custom OpenAI-compatible gateway
# FIN_AGENT_API_KEY=
# FIN_AGENT_BASE_URL=https://api.deepseek.com
# FIN_AGENT_TIMEOUT=30
# FIN_AGENT_MAX_RETRIES=2
# FIN_AGENT_THINKING=false
FIN_AGENT_ALLOW_EXTERNAL=false

# Service ports
GATEWAY_PORT=8080
RETRIEVAL_PORT=8081
INGEST_PORT=8082
AGENT_PORT=8083
MODEL_GATEWAY_PORT=8084
