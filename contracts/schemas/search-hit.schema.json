{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Polar12e/SourceKB-GroundedKB/contracts/schemas/search-hit.schema.json",
  "title": "SearchHit",
  "type": "object",
  "additionalProperties": false,
  "required": ["chunk_id", "document_id", "text", "locator", "anchor", "anchor_text", "channels", "score"],
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "$ref": "locator.schema.json"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_start", "line_end"],
      "properties": {
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "anchor_text": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "score": {
      "type": "number"
    },
    "matched_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
