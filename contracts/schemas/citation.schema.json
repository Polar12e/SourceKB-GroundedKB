{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Polar12e/SourceKB-GroundedKB/contracts/schemas/citation.schema.json",
  "title": "Citation",
  "description": "A citation that an answer can be checked against.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "page", "line_start", "line_end", "quote"],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
