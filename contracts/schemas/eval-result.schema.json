{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Polar12e/SourceKB-GroundedKB/contracts/schemas/eval-result.schema.json",
  "title": "EvalResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "status", "metrics", "latency_ms"],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["pass", "fail", "error"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hit_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "faithfulness": {"type": "number", "minimum": 0, "maximum": 1},
        "abstention": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "answer": {
      "$ref": "answer.schema.json"
    },
    "error": {
      "type": "string"
    }
  }
}
