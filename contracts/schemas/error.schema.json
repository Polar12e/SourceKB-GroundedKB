{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Polar12e/SourceKB-GroundedKB/contracts/schemas/error.schema.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
