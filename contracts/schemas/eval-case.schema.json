{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Polar12e/SourceKB-GroundedKB/contracts/schemas/eval-case.schema.json",
  "title": "EvalCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "question", "type", "gold_evidence", "split"],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["lookup", "explain", "compare", "multihop", "table", "negative", "ambiguous"]
    },
    "gold_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "split": {
      "enum": ["dev", "holdout", "diagnostic"]
    }
  }
}
